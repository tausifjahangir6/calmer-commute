# Normalize line endings to LF in the repository for all text files,
# regardless of what OS/editor a contributor is using. Git still converts
# to the local OS's convention in each person's working copy (CRLF on
# Windows) -- this only controls what's actually stored in the repo, so
# diffs don't show every line as changed just because someone edited on a
# different OS.
* text=auto eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.sh  text eol=lf
*.txt text eol=lf

# Windows-specific scripts, if any ever get added, keep CRLF since that's
# what Windows tooling expects.
*.bat text eol=crlf
*.ps1 text eol=crlf

# BINARY -- never touch line endings in these. This is the important one:
# rf_model.joblib is a serialized pickle, not text. If Git tried to
# "normalize" bytes inside it that happen to look like CRLF/LF, it would
# silently corrupt the model file.
*.joblib binary
*.pkl    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary

# CSVs are text, but explicit here so autocrlf/eol rules aren't ambiguous
# for large data files like sensor_network_features.csv or
# per_sensor_mae.csv.
*.csv text eol=lf
